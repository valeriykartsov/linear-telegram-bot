    {
      "parameters": {
        "jsCode": "const issues = $input.all();\n\nconst text = issues\n  .map(item => {\n    const issue = item.json;\n\n    const title = String(issue.title || '')\n      .replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '');\n\n    return `${issue.identifier} — ${title}`;\n  })\n  .join('\\n');\n\nreturn [\n  {\n    json: {\n      text: `📋 Задачи Linear:\\n\\n${text}`\n    }\n  }\n];"
      },
