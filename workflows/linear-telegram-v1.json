    {
      "parameters": {
        "jsCode": "const today = $now\n  .setZone('Europe/Amsterdam')\n  .toFormat('yyyy-MM-dd');\n\nconst issues = $input.all().filter(item => {\n  return item.json.dueDate === today;\n});\n\nif (issues.length === 0) {\n  return [{\n    json: {\n      text: `📅 На сегодня задач нет.\\n\\nДата: ${today}`\n    }\n  }];\n}\n\nconst text = issues\n  .map(item => `${item.json.identifier} — ${item.json.title}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    text: `📅 Задачи на сегодня (${today}):\\n\\n${text}`\n  }\n}];"
      },
